# =============================================================================
# DevAgent environment configuration  (copy to .env and fill in)
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# NEVER commit a real .env file. Only this template lives in the repository.
# =============================================================================

# ---------- Application ----------
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Secrets ----------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-not-a-real-secret
JWT_SECRET=change-me-dev-only-not-a-real-secret

# ---------- Database (Supabase PostgreSQL + pgvector) ----------
# Supabase session pooler URI format:
DATABASE_URL=postgresql://postgres.baubeysvfehwcymzmpvp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Optional: separate test database URL
TEST_DATABASE_URL=postgresql://postgres.baubeysvfehwcymzmpvp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ---------- LLM provider (provider independent) ----------
# LLM_PROVIDER: openai | anthropic | ollama | replay
#   * replay is a DEV-ONLY deterministic script replayer. It is NOT an AI model.
#     It exists so the pipeline can be exercised offline; it requires
#     ALLOW_DEV_PROVIDERS=true and is refused when ENV=production.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Base URL override (Azure/proxy/self-hosted). For ollama: http://localhost:11434
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
DEV_LLM_SCRIPT=

# ---------- Embeddings ----------
# EMBEDDING_PROVIDER: openai | ollama | hashing
#   * hashing is a DEV-ONLY bag-of-tokens embedder. It is NOT semantic search.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64
# Must be true to enable the dev-only providers above.
ALLOW_DEV_PROVIDERS=false

# ---------- GitHub ----------
# Only a server-side token for cloning *private* repositories and (later) push/PR.
# Never exposed to the frontend. Leave empty for public repositories only.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Comma separated allowlist of git hosts that may be cloned (SSRF protection).
ALLOWED_GIT_HOSTS=github.com

# ---------- Repository ingestion ----------
# Local path import exists for offline development and the fixture repository.
# It is disabled by default and additionally restricted to LOCAL_IMPORT_ROOTS.
ALLOW_LOCAL_REPO_IMPORT=false
LOCAL_IMPORT_ROOTS=./fixtures
MAX_REPO_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=300
CLONE_DEPTH=50
INDEX_MAX_FILES=3000
INDEX_MAX_FILE_BYTES=400000

# ---------- Agent budgets (loop limits) ----------
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_TOKENS=120000
AGENT_TIMEOUT_SECONDS=900
MAX_FIX_ATTEMPTS=3

# ---------- Retrieval ----------
RETRIEVAL_VECTOR_K=40
RETRIEVAL_FTS_K=40
RETRIEVAL_TOP_N=12
CONTEXT_TOKEN_BUDGET=8000

# ---------- Docker sandbox ----------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=devagent/runner-python:3.12
SANDBOX_MAX_SECONDS=300
SANDBOX_CPUS=1.0
SANDBOX_MEM_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=none
SANDBOX_OUTPUT_LIMIT_BYTES=1048576
SANDBOX_ALLOW_NETWORK_INSTALL=false
MAX_CONCURRENT_SANDBOXES=2
SANDBOX_TTL_SECONDS=3600

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------- Frontend build (public values only - never put secrets here) ----------
const API_BASE = import.meta.env.VITE_API_BASE_URL || '/api';
