# =============================================================================
# DevAgent Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and configure values for your environment:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# NEVER commit your real .env file. Only this template lives in Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Settings
# -----------------------------------------------------------------------------
# ENV: development | test | production
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8010

# Ports
BACKEND_PORT=8010
FRONTEND_PORT=8080
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 2. Security & Authentication
# -----------------------------------------------------------------------------
# Generate strong 48+ character secrets in production using:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production (ENV=production), placeholder values starting with "devagent-insecure"
# will cause the backend to immediately refuse startup.
SECRET_KEY=devagent-insecure-development-key-change-in-production
JWT_SECRET=devagent-insecure-development-jwt-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=10

# -----------------------------------------------------------------------------
# 3. Database (PostgreSQL + pgvector / Supabase)
# -----------------------------------------------------------------------------
# Standard PostgreSQL URI format:
#   postgresql://user:password@host:port/dbname
#   (backend automatically maps postgresql:// to postgresql+asyncpg://)
#
# Supabase Transaction / Session Pooler example:
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://devagent:devagent@localhost:5432/devagent

# Optional dedicated test database URL for running integration tests:
# TEST_DATABASE_URL=postgresql://devagent:devagent@localhost:5432/devagent_test

# -----------------------------------------------------------------------------
# 4. Redis (arq Job Queue & Event Pub/Sub)
# -----------------------------------------------------------------------------
# Local connection: redis://localhost:6379/0
# Docker Compose internal network: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 5. LLM Inference Provider
# -----------------------------------------------------------------------------
# LLM_PROVIDER: ollama | openai | anthropic | replay
#   * ollama: Local inference with Ollama (default for local development)
#   * openai: Cloud inference via OpenAI API (requires LLM_API_KEY)
#   * anthropic: Cloud inference via Anthropic API (requires LLM_API_KEY)
#   * replay: DEV-ONLY deterministic script replayer (requires ALLOW_DEV_PROVIDERS=true)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b

# Ollama Base URL:
#   * Running locally on host: http://localhost:11434
#   * Running inside Docker Compose: http://host.docker.internal:11434
LLM_BASE_URL=http://localhost:11434

# API Key (required for openai / anthropic, leave blank for ollama):
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
DEV_LLM_SCRIPT=

# -----------------------------------------------------------------------------
# 6. Retrieval & Vector Embeddings
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER: ollama | openai | hashing
#   * ollama: Local nomic-embed-text (dim=768)
#   * openai: Cloud text-embedding-3-small (dim=1536, requires LLM_API_KEY)
#   * hashing: DEV-ONLY bag-of-tokens stub (requires ALLOW_DEV_PROVIDERS=true)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# Safety guard: must remain false in production. Refuses startup if true when ENV=production.
ALLOW_DEV_PROVIDERS=false

# -----------------------------------------------------------------------------
# 7. GitHub Integration (Optional)
# -----------------------------------------------------------------------------
# Server-side token for cloning private repositories. Never exposed to clients.
# Leave blank to allow cloning public repositories only.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Comma-separated allowlist of git host domains (SSRF protection)
ALLOWED_GIT_HOSTS=github.com

# -----------------------------------------------------------------------------
# 8. Repository Ingestion & Workspace Limits
# -----------------------------------------------------------------------------
ALLOW_LOCAL_REPO_IMPORT=false
LOCAL_IMPORT_ROOTS=./fixtures
MAX_REPO_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=300
CLONE_DEPTH=50
INDEX_MAX_FILES=3000
INDEX_MAX_FILE_BYTES=400000

# -----------------------------------------------------------------------------
# 9. Autonomous Agent Loop Limits
# -----------------------------------------------------------------------------
AGENT_MAX_STEPS=18
AGENT_MAX_TOOL_CALLS=36
AGENT_MAX_TOKENS=150000
AGENT_TIMEOUT_SECONDS=900
TASK_TIMEOUT_SECONDS=900
MAX_FIX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# 10. Hybrid Retrieval Tuning
# -----------------------------------------------------------------------------
RETRIEVAL_VECTOR_K=40
RETRIEVAL_FTS_K=40
RETRIEVAL_TOP_N=12
CONTEXT_TOKEN_BUDGET=8000

# -----------------------------------------------------------------------------
# 11. Docker Execution Sandbox
# -----------------------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=devagent/runner-python:3.12
SANDBOX_MAX_SECONDS=300
SANDBOX_CPUS=1.0
SANDBOX_MEM_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=none
SANDBOX_OUTPUT_LIMIT_BYTES=1048576
SANDBOX_ALLOW_NETWORK_INSTALL=false
MAX_CONCURRENT_SANDBOXES=2
SANDBOX_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# 12. Rate Limiting (Defense in Depth)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# 13. Frontend Build Configuration (Vite Public Variables)
# -----------------------------------------------------------------------------
# Vite only exposes environment variables prefixed with VITE_ to the browser.
# NEVER include private API keys or database connection strings here.
VITE_API_BASE_URL=/api
